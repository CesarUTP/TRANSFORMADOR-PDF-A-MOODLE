# Entornos virtuales y dependencias
backend/venv/
__pycache__/
*.pyc

# Datos en tiempo de ejecución del repo de desarrollo: historial (.db), clave cifrada
# (clave.dat) y todo lo demás que la app escriba ahí. Nunca se versiona.
data/

# Huellas SHA-256 de los instaladores (dev/huellas_instaladores.py): se suben al release, no al repositorio
dist-huellas/

# Material local que no es parte de la app (CLAUDE.md: «Nunca commitear»)
.agents/
videos/
.impeccable/

# Builds
build/
dist/
*.spec

# Archivos de sistema
.DS_Store

# Configuración local del editor / herramientas de IA (no compartida)
.claude/
.vscode/
.idea/

# Ejecutable empaquetado (se genera en Windows/macOS, no se versiona)
ejecutable/build_venv/
ejecutable/build/
ejecutable/dist/
ejecutable/Output/
ejecutable_mac/build_venv/

# Log de arranque del ejecutable (se genera solo, para depurar)
launcher_error.log

# Salidas de scripts de desarrollo (dev/)
dev/*.pdf
dev/resultado_test.txt
dev/test_output.txt
dev/api_resp.json

# Secretos locales (API keys) — nunca se versionan
.env
backend/.env

# Registro de errores del backend (se genera solo, para depurar)
errores.log
